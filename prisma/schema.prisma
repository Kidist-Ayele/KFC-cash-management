// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles for the system
enum Role {
  CASHIER
  MANAGER
  ADMIN
  SUPER_ADMIN
}

// Payment channels available
enum PaymentChannel {
  TELEBIRR
  KUKU_CBE
  SAMUEL_CBE
  CASH
}

// Order status
enum OrderStatus {
  PAID
  UNPAID
  CANCELLED
}

// Menu categories matching live digital menu
enum Category {
  SHAWARMA
  ROASTED
  CRISPY
  BURGER
  FISH
  PIZZA
  DRINKS
  EXTRAS
}

// Shift types
enum Shift {
  MORNING
  AFTERNOON
  EVENING
}

// Expense categories
enum ExpenseCategory {
  SUPPLIES
  INGREDIENTS
  UTILITIES
  MAINTENANCE
  OTHER
}

// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(CASHIER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  shifts         ShiftReport[]
  expenses       Expense[]
  cashierShifts  CashierShift[]
}

// Waiter model
model Waiter {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  pettyCash  WaiterPettyCash[]
}

// Waiter Petty Cash (Floats given to waiters during shift)
model WaiterPettyCash {
  id          String   @id @default(cuid())
  waiterId    String
  amount      Float
  givenBy     String   // Cashier name
  notes       String?
  createdAt   DateTime @default(now())

  waiter Waiter @relation(fields: [waiterId], references: [id], onDelete: Cascade)
}

// Cashier Shift (Beginning cash, shift management, and cash drawer closing reconciliation)
model CashierShift {
  id             String    @id @default(cuid())
  cashierId      String
  cashierName    String
  shiftType      Shift     @default(MORNING)
  beginningCash  Float     @default(0) // Starting drawer float
  closingCash    Float?    // Actual physical cash counted at end of shift
  expectedCash   Float?    // beginningCash + cashFromSales - totalExpenses - tipsPaidOut
  cashDifference Float?    // closingCash - expectedCash (Over / Short)
  totalCashSales Float     @default(0)
  totalTransfer  Float     @default(0)
  totalExpenses  Float     @default(0)
  totalTipsGiven Float     @default(0)
  notes          String?
  status         String    @default("ACTIVE") // ACTIVE or CLOSED
  startedAt      DateTime  @default(now())
  closedAt       DateTime?

  user User @relation(fields: [cashierId], references: [id])
}

// Menu Item model
model MenuItem {
  id          String     @id @default(cuid())
  name        String
  price       Float
  category    Category
  description String?
  imageUrl    String?
  isAvailable Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orderItems OrderItem[]
}

// Order model
model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  subtotal       Float
  vat            Float
  total          Float
  amountPaid     Float?         // Actual amount received/transferred by customer
  tip            Float          @default(0) // Extra amount = max(0, amountPaid - total)
  status         OrderStatus    @default(UNPAID)
  paymentChannel PaymentChannel?
  waiter         String?
  waiterId       String?
  userId         String
  shift          Shift
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  waiterRel  Waiter?     @relation(fields: [waiterId], references: [id])
  orderItems OrderItem[]
}

// Order Item (junction table with quantity)
model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  price      Float    // Snapshot price at time of order
  orderId    String
  menuItemId String
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

// Expense model
model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  addedBy     String
  userId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

// Shift Report model
model ShiftReport {
  id            String   @id @default(cuid())
  shift         Shift
  totalRevenue  Float
  totalOrders   Int
  cashierName   String
  userId        String
  startTime     DateTime
  endTime       DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Branch model for multi-location scalability
model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  location    String
  manager     String?
  phone       String?
  status      String   @default("ACTIVE") // ACTIVE, COMING_SOON, INACTIVE
  staffCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// System-wide persistent settings
model SystemSetting {
  id             String   @id @default("default")
  companyName    String   @default("Kuku Fried Chicken (KFC)")
  branchName     String   @default("Main Branch — Ayat, Addis Ababa")
  ownerName      String   @default("Samuel Mulat")
  managerName    String   @default("Lishan Bekele")
  vatRate        Float    @default(15)
  currency       String   @default("ETB")
  timezone       String   @default("Africa/Addis_Ababa")
  telegramBot    String   @default("@kuku_kfc_report_bot")
  telegramChatId String   @default("1794854523")
  telebirrActive Boolean  @default(true)
  kukuCbeActive  Boolean  @default(true)
  samuelCbeActive Boolean @default(true)
  cashActive     Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

